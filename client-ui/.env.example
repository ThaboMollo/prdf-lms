VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Local NestJS API default is 3000 (backend-node). In production this MUST
# be the deployed API origin, e.g. https://prdf-api.vercel.app — a
# localhost value here silently produces a build where every
# authenticated call fails for real users.
VITE_API_BASE_URL=http://localhost:3000
