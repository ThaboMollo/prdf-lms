SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_AUDIENCE=authenticated
# Transaction-mode Supavisor pooler (port 6543), not the direct connection
# (port 5432, host db.<project>.supabase.co) used previously. Required for
# serverless: each cold function instance keeps its own small Pool
# (DatabaseService max: 3), and Supavisor — not this Pool — is what protects
# Postgres from a connection storm across many concurrent instances. Find
# the exact pooler host/port for your project under Supabase Dashboard ->
# Project Settings -> Database -> Connection pooling (mode: Transaction).
SUPABASE_DB_CONNECTION_STRING=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:6543/postgres
# Bearer token required by POST /internal/cron/notification-sweep — set as
# the Vercel Cron job's Authorization header. Generate a long random value,
# never reuse a real user-facing secret.
CRON_SECRET=change-me
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
PORT=3000
# Optional — unset disables Sentry reporting entirely (safe no-op), doesn't
# error. Only unhandled 500s are reported (see AllExceptionsFilter).
SENTRY_DSN=
